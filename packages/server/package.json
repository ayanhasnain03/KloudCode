{
  "name": "@kloud-code/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun src/index.ts",
    "postinstall": "bun run --cwd ../database db:generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/openai": "^4.0.16",
    "@hono/zod-validator": "^0.9.0",
    "@kloud-code/database": "workspace:*",
    "@kloud-code/shared": "workspace:*",
    "@sentry/bun": "^10.67.0",
    "@sentry/hono": "^10.67.0",
    "ai": "^7.0.32",
    "hono": "^4.12.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
